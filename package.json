{
  "name": "neatly-hotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:login": "dotenv -e .env.local -- vitest run src/features/auth/actions.test.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check-rate-limit": "node --env-file=.env.local scripts/check-api-rate-limit.mjs",
    "security:check-support-cap": "node --env-file=.env.local scripts/check-live-support-message-cap.mjs",
    "security:check-live-support": "node --env-file=.env.local scripts/check-live-support-rls.mjs",
    "security:check-authorization": "node scripts/check-booking-access.mjs",
    "check:booking-lifecycle": "node --experimental-strip-types scripts/check-booking-lifecycle.mjs",
    "security:check-admin-booking-edit": "node scripts/check-admin-booking-edit.mjs",
    "check:chatbot-routing": "node --experimental-strip-types scripts/check-chatbot-routing.mjs",
    "postinstall": "prisma generate",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:seed-rooms": "dotenv -e .env.local -- prisma db execute --file supabase/seed-rooms-layout.sql --schema prisma/schema.prisma",
    "db:apply-promo": "dotenv -e .env.local -- prisma db execute --file supabase/migrations/0006_promotion_codes.sql --schema prisma/schema.prisma",
    "db:apply-booking-status": "dotenv -e .env.local -- prisma db execute --file supabase/migrations/0007_booking_status_check.sql --schema prisma/schema.prisma",
    "db:apply-guest-booking": "dotenv -e .env.local -- prisma db execute --file supabase/migrations/0008_guest_booking_nullable_customer.sql --schema prisma/schema.prisma",
    "db:apply-email-otp": "dotenv -e .env.local -- prisma db execute --file supabase/migrations/0009_email_otp.sql --schema prisma/schema.prisma",
    "db:apply-analytics-tracking": "dotenv -e .env.local -- prisma db execute --file supabase/migrations/202608310001_analytics_tracking.sql --schema prisma/schema.prisma",
    "db:apply-notifications": "dotenv -e .env.local -- prisma db execute --file supabase/migrations/202609020001_add_notifications.sql --schema prisma/schema.prisma",
    "db:execute-hotel": "dotenv -e .env.local -- prisma db execute --file prisma/migrations/20260814090000_init_postgres/migration.sql --schema prisma/schema.prisma",
    "db:setup": "npm run db:execute-hotel && npm run db:generate && npm run db:seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.18.0",
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "next": "16.3.0",
    "nodemailer": "^9.1.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
