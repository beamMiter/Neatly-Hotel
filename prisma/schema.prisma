// Prisma mapped to existing Supabase public tables + hotel_information

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  roomNo     String   @unique @map("room_no") @db.VarChar(16)
  roomType   String   @map("room_type") @db.VarChar(100)
  bedType    String   @map("bed_type") @db.VarChar(50)
  status     String   @db.VarChar(50)
  roomTypeId String?  @map("room_type_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roomTypeRel RoomType?     @relation(fields: [roomTypeId], references: [id])
  bookingRooms BookingRoom[]

  @@index([status])
  @@index([roomNo])
  @@map("rooms")
}

model RoomType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  bedType     String?  @map("bed_type")
  capacity    Int?
  sizeSqm     Decimal? @map("size_sqm") @db.Decimal
  basePrice   Decimal? @map("base_price") @db.Decimal
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms  Room[]
  images RoomImage[]

  @@map("room_types")
}

model RoomImage {
  id         String  @id @default(uuid()) @db.Uuid
  roomTypeId String  @map("room_type_id") @db.Uuid
  storagePath String @map("storage_path")
  altText    String? @map("alt_text")
  sortOrder  Int     @default(0) @map("sort_order")
  isCover    Boolean @default(false) @map("is_cover")

  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@map("room_images")
}

model Booking {
  id          String   @id @default(uuid()) @db.Uuid
  bookingCode String   @map("booking_code")
  customerId  String   @map("customer_id") @db.Uuid
  checkIn     DateTime @map("check_in") @db.Date
  checkOut    DateTime @map("check_out") @db.Date
  guests      Int
  status      String
  totalAmount Decimal  @map("total_amount") @db.Decimal
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rooms BookingRoom[]

  @@map("bookings")
}

model BookingRoom {
  bookingId     String  @map("booking_id") @db.Uuid
  roomId        String  @map("room_id") @db.Uuid
  pricePerNight Decimal @map("price_per_night") @db.Decimal

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@id([bookingId, roomId])
  @@map("booking_rooms")
}

model HotelInformation {
  id          String   @id
  name        String
  description String
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("hotel_information")
}

model PromotionCode {
  id                     String    @id @default(uuid()) @db.Uuid
  code                   String    @unique
  discountType           String    @map("discount_type")
  discountValue          Decimal   @map("discount_value") @db.Decimal
  minSubtotal            Decimal?  @map("min_subtotal") @db.Decimal
  validFrom              DateTime? @map("valid_from") @db.Date
  validTo                DateTime? @map("valid_to") @db.Date
  isActive               Boolean   @default(true) @map("is_active")
  applicableRoomTypeIds  String[]  @default([]) @map("applicable_room_type_ids") @db.Uuid
  maxUses                Int?      @map("max_uses")
  usedCount              Int       @default(0) @map("used_count")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([code])
  @@index([isActive])
  @@map("promotion_codes")
}
