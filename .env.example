# Copy to `.env.local` for Next.js + Prisma CLI (via npm run db:*)
# Never commit `.env.local` to git.

# Local SQLite (default for team dev — no remote Supabase yet)
DATABASE_URL="file:./dev.db"

# Later: cloud Supabase (switch prisma/schema.prisma provider to postgresql first)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
