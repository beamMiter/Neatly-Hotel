NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional — hash/sign email OTP codes (falls back to SUPABASE_SECRET_KEY)
EMAIL_OTP_SECRET=

# Optional — send OTP emails via Resend (https://resend.com)
RESEND_API_KEY=
# RESEND_FROM="Neatly Hotel <onboarding@resend.dev>"

# Optional — SMTP (preferred over Resend when set). Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Neatly Hotel <you@gmail.com>"
RATE_LIMIT_SALT=
GEMINI_API_KEY=


GEMINI_MODEL=gemini-3.6-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Test-mode secret key from Stripe dashboard — needed for booking payment,
# and for cancel/refund (bookings.query.ts calls Stripe to issue refunds)
STRIPE_SECRET_KEY=

# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` to git.

# Supabase Postgres via Session pooler (Prisma)
# Replace [YOUR-PASSWORD] — URL-encode special characters
DATABASE_URL="postgresql://postgres.rhmfozmfmhrhswfzrkua:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
